    /* =========================================================
       STYLE INJECTION
       ========================================================= */

    function injectStyle() {
        if (
            document.getElementById(
                'gn-v33-style'
            )
        ) {
            return;
        }

        const style =
            document.createElement(
                'style'
            );

        style.id =
            'gn-v33-style';

        style.textContent =
            css;

        (
            document.head ||
            document.documentElement
        ).appendChild(style);
    }


    injectStyle();


    /* =========================================================
       COLOUR HELPERS
       ========================================================= */

    function parseColor(value) {
        const match =
            value?.match(
                /rgba?\(\s*(\d+)\D+(\d+)\D+(\d+)(?:\D+([\d.]+))?/i
            );

        if (!match) {
            return null;
        }

        return {
            r: +match[1],
            g: +match[2],
            b: +match[3],

            a:
                match[4] === undefined
                    ? 1
                    : +match[4]
        };
    }


    function luminance(color) {
        return color
            ? (
                color.r * .2126 +
                color.g * .7152 +
                color.b * .0722
            )
            : 0;
    }


    function spread(color) {
        return color
            ? (
                Math.max(
                    color.r,
                    color.g,
                    color.b
                ) -
                Math.min(
                    color.r,
                    color.g,
                    color.b
                )
            )
            : 0;
    }


    function rect(element) {
        const value =
            element.getBoundingClientRect();

        return (
            value.width > 0 &&
            value.height > 0
        )
            ? value
            : null;
    }


    /* =========================================================
       MAP DETECTION
       ========================================================= */

    function classifyMapMedia() {
        let biggest =
            null;

        let biggestArea =
            0;

        document
            .querySelectorAll(
                'img,canvas,video'
            )
            .forEach(element => {
                const areaRect =
                    rect(element);

                if (!areaRect) {
                    return;
                }

                const area =
                    areaRect.width *
                    areaRect.height;

                if (
                    areaRect.width >
                        400 &&
                    areaRect.height >
                        260
                ) {
                    element.classList.add(
                        'gn-v33-map-media'
                    );

                    if (
                        area >
                        biggestArea
                    ) {
                        biggestArea =
                            area;

                        biggest =
                            areaRect;
                    }
                }
            });

        return biggest;
    }


    function insideMapArea(
        element,
        mapRect
    ) {
        if (!mapRect) {
            return false;
        }

        const area =
            rect(element);

        if (!area) {
            return false;
        }

        /*
         * The left sidebar remains themeable.
         */
        if (
            area.left <
            220
        ) {
            return false;
        }

        const centerX =
            area.left +
            area.width / 2;

        const centerY =
            area.top +
            area.height / 2;

        return (
            centerX >=
                mapRect.left &&
            centerX <=
                mapRect.right &&
            centerY >=
                mapRect.top &&
            centerY <=
                mapRect.bottom
        );
    }


    /* =========================================================
       ELEMENT FILTERING
       ========================================================= */

    function isIgnored(element) {
        if (
            !(
                element instanceof
                HTMLElement
            )
        ) {
            return true;
        }

        if (
            element.closest(
                '#gn-v33-panel,#gn-v33-button'
            )
        ) {
            return true;
        }

        return /^(IMG|CANVAS|VIDEO|SVG|PATH|PICTURE|SOURCE|SCRIPT|STYLE|LINK|META)$/
            .test(
                element.tagName
            );
    }


    function setImportant(
        element,
        property,
        value
    ) {
        if (
            element.style
                .getPropertyValue(
                    property
                ) ===
                value &&
            element.style
                .getPropertyPriority(
                    property
                ) ===
                'important'
        ) {
            return;
        }

        element.style.setProperty(
            property,
            value,
            'important'
        );
    }


    /* =========================================================
       THEME PAINT
       ========================================================= */

    function paintElement(
        element,
        mapRect
    ) {
        if (
            isIgnored(element)
        ) {
            return;
        }

        const area =
            rect(element);

        if (!area) {
            return;
        }

        if (
            insideMapArea(
                element,
                mapRect
            )
        ) {
            return;
        }

        const computed =
            getComputedStyle(element);

        const background =
            parseColor(
                computed.backgroundColor
            );

        const foreground =
            parseColor(
                computed.color
            );

        const border =
            parseColor(
                computed.borderTopColor
            );

        const backgroundImage =
            computed.backgroundImage ||
            'none';

        const hasRealImage =
            backgroundImage.includes(
                'url('
            );

        const hasGradient =
            backgroundImage !==
                'none' &&
            !hasRealImage;


        if (
            hasGradient
        ) {
            setImportant(
                element,
                'background-image',
                'none'
            );
        }


        if (
            !hasRealImage &&
            background &&
            background.a >
                .03
        ) {
            const light =
                luminance(
                    background
                );

            const colourSpread =
                spread(
                    background
                );

            const huge =
                area.width >
                    innerWidth *
                    .35 &&
                area.height >
                    innerHeight *
                    .18;

            const bar =
                area.width >
                    110 &&
                area.height >=
                    14 &&
                area.height <=
                    48;

            const yellow =
                background.r >
                    120 &&
                background.g >
                    105 &&
                background.b <
                    135;

            const blueCyan =
                (
                    background.b >
                        background.r + 18 &&
                    background.b >
                        background.g + 6
                ) ||
                (
                    background.g >
                        background.r + 25 &&
                    background.b >
                        background.r + 20
                );

            const red =
                background.r >
                    background.g + 35 &&
                background.r >
                    background.b + 20;

            const green =
                background.g >
                    background.r + 25 &&
                background.g >
                    background.b + 10;


            if (
                yellow
            ) {
                setImportant(
                    element,
                    'background-color',
                    '#21171b'
                );

                setImportant(
                    element,
                    'color',
                    '#eadadd'
                );
            }


            else if (
                red &&
                bar
            ) {
                setImportant(
                    element,
                    'background-color',
                    '#261416'
                );

                setImportant(
                    element,
                    'color',
                    '#e5cbd0'
                );
            }


            else if (
                green &&
                bar
            ) {
                setImportant(
                    element,
                    'background-color',
                    '#172019'
                );

                setImportant(
                    element,
                    'color',
                    '#d1ddd3'
                );
            }


            else if (
                blueCyan &&
                bar
            ) {
                setImportant(
                    element,
                    'background-color',
                    '#11191d'
                );

                setImportant(
                    element,
                    'color',
                    '#cfdbdf'
                );
            }


            else if (
                light >
                180
            ) {
                setImportant(
                    element,
                    'background-color',
                    huge
                        ? '#08090b'
                        : '#0e1013'
                );
            }


            else if (
                light >
                    95 &&
                colourSpread <
                    70
            ) {
                setImportant(
                    element,
                    'background-color',
                    huge
                        ? '#08090b'
                        : '#0e1013'
                );
            }


            else if (
                area.left <
                    210 &&
                light >
                    55 &&
                colourSpread <
                    95
            ) {
                setImportant(
                    element,
                    'background-color',
                    '#0d0f12'
                );
            }
        }


        if (
            border &&
            luminance(border) >
                100
        ) {
            setImportant(
                element,
                'border-color',
                'rgba(255,255,255,.035)'
            );
        }


        if (
            foreground &&
            luminance(foreground) <
                125 &&
            spread(foreground) <
                75
        ) {
            setImportant(
                element,
                'color',
                '#d2d4d7'
            );
        }


        /*
         * Old Vulnona sidebar rows.
         */

        if (
            area.left <
                210 &&
            area.width >
                85 &&
            area.height >=
                15 &&
            area.height <=
                34
        ) {
            const text =
                (
                    element.textContent ||
                    ''
                )
                    .replace(
                        /\s+/g,
                        ' '
                    )
                    .trim();

            if (
                text &&
                text.length <
                    45 &&
                !element.matches(
                    'input,select,textarea'
                )
            ) {
                if (
                    !hasRealImage
                ) {
                    setImportant(
                        element,
                        'background-image',
                        'none'
                    );

                    setImportant(
                        element,
                        'background-color',
                        '#121419'
                    );

                    setImportant(
                        element,
                        'color',
                        '#d7d9dc'
                    );

                    setImportant(
                        element,
                        'box-shadow',
                        'none'
                    );

                    setImportant(
                        element,
                        'text-shadow',
                        'none'
                    );
                }
            }
        }
    }


    /* =========================================================
       AUTOMATIC DEFAULT MAP OPTIONS
       ========================================================= */

    function normalizeText(value) {
        return String(
            value ||
            ''
        )
            .toLowerCase()
            .replace(
                /[^a-z0-9]+/g,
                ' '
            )
            .replace(
                /\s+/g,
                ' '
            )
            .trim();
    }


    function checkboxDescriptions(
        checkbox
    ) {
        const direct = [];
        const nearby = [];


        /*
         * IDs/names are especially useful if Vulnona
         * happens to expose a sensible internal name.
         */

        direct.push(
            checkbox.id || '',
            checkbox.name || '',
            checkbox.value || '',
            checkbox.title || '',
            checkbox.getAttribute(
                'aria-label'
            ) || ''
        );


        /*
         * Native labels associated with this checkbox.
         */

        if (
            checkbox.labels
        ) {
            for (
                const label
                of checkbox.labels
            ) {
                direct.push(
                    label.textContent || ''
                );
            }
        }


        /*
         * Checkbox nested inside <label>.
         */

        const wrappingLabel =
            checkbox.closest(
                'label'
            );

        if (
            wrappingLabel
        ) {
            direct.push(
                wrappingLabel.textContent || ''
            );
        }


        /*
         * Closest siblings.
         */

        const previous =
            checkbox.previousElementSibling;

        const next =
            checkbox.nextElementSibling;


        if (previous) {
            nearby.push(
                previous.textContent || ''
            );
        }


        if (next) {
            nearby.push(
                next.textContent || ''
            );
        }


        /*
         * Vulnona's old markup often places the checkbox and
         * its label text together inside a small parent element.
         *
         * Only inspect reasonably small containers so we don't
         * accidentally match an entire sidebar section.
         */

        let parent =
            checkbox.parentElement;


        for (
            let level = 0;
            parent &&
            level < 3;
            level++,
            parent = parent.parentElement
        ) {
            const text =
                (
                    parent.textContent ||
                    ''
                )
                    .replace(
                        /\s+/g,
                        ' '
                    )
                    .trim();

            if (
                text.length > 0 &&
                text.length <= 180
            ) {
                nearby.push(
                    text
                );
            }
        }


        return {
            direct:
                direct
                    .map(
                        normalizeText
                    )
                    .filter(Boolean),

            nearby:
                nearby
                    .map(
                        normalizeText
                    )
                    .filter(Boolean)
        };
    }


    function aliasScore(
        description,
        alias
    ) {
        if (
            !description ||
            !alias
        ) {
            return 0;
        }


        if (
            description ===
            alias
        ) {
            return 100;
        }


        if (
            description.includes(
                alias
            )
        ) {
            return 75;
        }


        if (
            alias.includes(
                description
            ) &&
            description.length >=
                6
        ) {
            return 55;
        }


        return 0;
    }


    function findCheckboxForAliases(
        aliases
    ) {
        const normalizedAliases =
            aliases.map(
                normalizeText
            );


        let bestCheckbox =
            null;

        let bestScore =
            0;


        for (
            const checkbox
            of document.querySelectorAll(
                'input[type="checkbox"]'
            )
        ) {
            if (
                checkbox.closest(
                    '#gn-v33-panel'
                )
            ) {
                continue;
            }


            const descriptions =
                checkboxDescriptions(
                    checkbox
                );


            let score =
                0;


            for (
                const alias
                of normalizedAliases
            ) {
                /*
                 * Direct label/id/name match.
                 */

                for (
                    const description
                    of descriptions.direct
                ) {
                    score =
                        Math.max(
                            score,
                            aliasScore(
                                description,
                                alias
                            ) + 40
                        );
                }


                /*
                 * Nearby text match.
                 */

                for (
                    const description
                    of descriptions.nearby
                ) {
                    score =
                        Math.max(
                            score,
                            aliasScore(
                                description,
                                alias
                            )
                        );
                }
            }


            if (
                score >
                bestScore
            ) {
                bestScore =
                    score;

                bestCheckbox =
                    checkbox;
            }
        }


        /*
         * Require a reasonably convincing match.
         */

        return bestScore >= 70
            ? bestCheckbox
            : null;
    }


    function enableCheckbox(
        checkbox
    ) {
        if (
            !checkbox ||
            checkbox.disabled
        ) {
            return false;
        }


        if (
            checkbox.checked
        ) {
            return true;
        }


        startupPresetRunning =
            true;


        try {
            /*
             * click() is preferable to merely assigning
             * .checked because Vulnona may have its own click
             * handler that redraws the relevant map layer.
             */

            checkbox.click();


            /*
             * Fallback for controls whose handler doesn't
             * respond to a programmatic click normally.
             */

            if (
                !checkbox.checked
            ) {
                checkbox.checked =
                    true;


                checkbox.dispatchEvent(
                    new Event(
                        'input',
                        {
                            bubbles: true
                        }
                    )
                );


                checkbox.dispatchEvent(
                    new Event(
                        'change',
                        {
                            bubbles: true
                        }
                    )
                );
            }
        }

        finally {
            startupPresetRunning =
                false;
        }


        return checkbox.checked;
    }


    function applyStartupDefaults() {
        /*
         * Only relevant on Vulnona's map.
         */

        if (
            !location.pathname
                .startsWith(
                    '/game/map'
                )
        ) {
            return;
        }


        for (
            const option
            of STARTUP_OPTIONS
        ) {
            if (
                !settings[
                    option.setting
                ]
            ) {
                continue;
            }


            const checkbox =
                findCheckboxForAliases(
                    option.aliases
                );


            if (
                checkbox &&
                !checkbox.checked
            ) {
                enableCheckbox(
                    checkbox
                );
            }
        }
    }


    function scheduleStartupDefaults() {
        /*
         * Vulnona builds some map-specific controls after
         * its first page load, so retry several times.
         *
         * These stop after startup rather than permanently
         * policing the controls, meaning you can still turn
         * one off manually afterwards.
         */

        [
            250,
            700,
            1400,
            2500,
            4500,
            7000,
            10000
        ].forEach(
            delay => {
                setTimeout(
                    applyStartupDefaults,
                    delay
                );
            }
        );
    }


    /* =========================================================
       APPLY THEME SETTINGS
       ========================================================= */

    function applySettings() {
        const root =
            document.documentElement;


        root.style.setProperty(
            '--gn-scale',
            String(
                settings.uiScale /
                100
            )
        );


        root.style.setProperty(
            '--gn-radius',
            `${settings.roundness}px`
        );


        root.style.setProperty(
            '--gn-map-brightness',
            String(
                settings.mapBrightness /
                100
            )
        );


        root.classList.toggle(
            'gn-v33-dim-map',
            settings.dimMap
        );
    }


    /* =========================================================
       MAIN PAINT PASS
       ========================================================= */

    function paint() {
        if (
            !document.body
        ) {
            return;
        }


        injectStyle();

        applySettings();


        setImportant(
            document.documentElement,
            'background-color',
            '#08090b'
        );


        setImportant(
            document.body,
            'background-color',
            '#08090b'
        );


        setImportant(
            document.body,
            'color',
            '#d2d4d7'
        );


        const mapRect =
            classifyMapMedia();


        document
            .querySelectorAll(`
                body,
                div,
                section,
                aside,
                nav,
                header,
                footer,
                main,
                article,
                table,
                tbody,
                thead,
                tfoot,
                tr,
                td,
                th,
                form,
                fieldset,
                p,
                span,
                label,
                h1,
                h2,
                h3,
                h4,
                h5,
                h6,
                ul,
                ol,
                li
            `)
            .forEach(
                element =>
                    paintElement(
                        element,
                        mapRect
                    )
            );
    }


    function queuePaint(
        delay = 0
    ) {
        if (
            paintQueued
        ) {
            return;
        }


        paintQueued =
            true;


        setTimeout(
            () => {
                paintQueued =
                    false;


                requestAnimationFrame(
                    paint
                );
            },
            delay
        );
    }


    /* =========================================================
       SETTINGS PANEL
       ========================================================= */

    function slider(
        name,
        label,
        min,
        max
    ) {
        return `
            <div class="gn-v33-row">

                <div class="gn-v33-label">
                    <span>${label}</span>
                    <span data-out="${name}"></span>
                </div>

                <input
                    type="range"
                    name="${name}"
                    min="${min}"
                    max="${max}"
                    step="1"
                >

            </div>
        `;
    }


    function toggle(
        name,
        label
    ) {
        return `
            <label class="gn-v33-toggle">

                <span>${label}</span>

                <input
                    type="checkbox"
                    name="${name}"
                >

            </label>
        `;
    }


    function installUI() {
        if (
            !TOP ||
            !document.body ||
            document.getElementById(
                'gn-v33-button'
            )
        ) {
            return;
        }


        const button =
            document.createElement(
                'button'
            );


        button.id =
            'gn-v33-button';

        button.type =
            'button';

        button.textContent =
            'GN';

        button.title =
            'Graphite Night settings';


        const panel =
            document.createElement(
                'div'
            );


        panel.id =
            'gn-v33-panel';


        panel.innerHTML = `
            <div class="gn-v33-title">
                Graphite Night
            </div>

            <div class="gn-v33-sub">
                VulnonaMAP v3.3
            </div>


            ${slider(
                'uiScale',
                'UI scale',
                90,
                125
            )}


            ${slider(
                'roundness',
                'Roundness',
                3,
                18
            )}


            ${slider(
                'mapBrightness',
                'Map brightness',
                65,
                105
            )}


            ${toggle(
                'dimMap',
                'Dim map'
            )}


            <div class="gn-v33-heading">
                Startup defaults
            </div>


            ${toggle(
                'defaultPatrolZones',
                'Patrol Zones'
            )}


            ${toggle(
                'defaultMigrationZones',
                'Migration Zones'
            )}


            ${toggle(
                'defaultSanctuary',
                'Sanctuary'
            )}


            ${toggle(
                'defaultAnimateLatestLocation',
                'Animate latest location'
            )}
        `;


        document.body.append(
            panel,
            button
        );


        button.addEventListener(
            'click',
            event => {
                event.stopPropagation();


                panel.classList.toggle(
                    'gn-open'
                );
            }
        );


        panel.addEventListener(
            'input',
            event => {
                const input =
                    event.target;


                if (
                    !(
                        input instanceof
                        HTMLInputElement
                    )
                ) {
                    return;
                }


                settings[
                    input.name
                ] =
                    input.type ===
                    'checkbox'
                        ? input.checked
                        : Number(
                            input.value
                        );


                save();

                applySettings();

                updateUI();

                queuePaint();


                if (
                    input.name.startsWith(
                        'default'
                    ) &&
                    input.checked
                ) {
                    setTimeout(
                        applyStartupDefaults,
                        50
                    );
                }
            }
        );


        document.addEventListener(
            'click',
            event => {
                if (
                    panel.classList
                        .contains(
                            'gn-open'
                        ) &&
                    !panel.contains(
                        event.target
                    ) &&
                    !button.contains(
                        event.target
                    )
                ) {
                    panel.classList.remove(
                        'gn-open'
                    );
                }
            }
        );


        updateUI();
    }


    function updateUI() {
        const panel =
            document.getElementById(
                'gn-v33-panel'
            );


        if (!panel) {
            return;
        }


        const values = {
            uiScale:
                `${settings.uiScale}%`,

            roundness:
                `${settings.roundness}px`,

            mapBrightness:
                `${settings.mapBrightness}%`
        };


        for (
            const [name, value]
            of Object.entries(values)
        ) {
            const output =
                panel.querySelector(
                    `[data-out="${name}"]`
                );


            const input =
                panel.querySelector(
                    `[name="${name}"]`
                );


            if (output) {
                output.textContent =
                    value;
            }


            if (input) {
                input.value =
                    settings[name];
            }
        }


        const toggleNames = [
            'dimMap',
            'defaultPatrolZones',
            'defaultMigrationZones',
            'defaultSanctuary',
            'defaultAnimateLatestLocation'
        ];


        for (
            const name
            of toggleNames
        ) {
            const input =
                panel.querySelector(
                    `[name="${name}"]`
                );


            if (input) {
                input.checked =
                    Boolean(
                        settings[name]
                    );
            }
        }
    }


    /* =========================================================
       START
       ========================================================= */

    function start() {
        injectStyle();

        applySettings();

        installUI();

        paint();


        /*
         * Automatically enable the preferred options.
         */

        scheduleStartupDefaults();


        /*
         * Vulnona dynamically changes existing controls.
         */

        const observer =
            new MutationObserver(
                mutations => {
                    queuePaint(25);


                    /*
                     * During initial loading, new controls may
                     * appear after map data has finished loading.
                     */

                    if (
                        !startupPresetRunning
                    ) {
                        const addedControls =
                            mutations.some(
                                mutation =>
                                    mutation.type ===
                                        'childList' &&
                                    mutation.addedNodes
                                        .length > 0
                            );


                        if (
                            addedControls
                        ) {
                            setTimeout(
                                applyStartupDefaults,
                                120
                            );
                        }
                    }
                }
            );


        observer.observe(
            document.documentElement,
            {
                childList:
                    true,

                subtree:
                    true,

                attributes:
                    true,

                attributeFilter: [
                    'style',
                    'hidden',
                    'open',
                    'aria-expanded',
                    'class'
                ]
            }
        );


        /*
         * Repaint after normal site interactions.
         */

        document.addEventListener(
            'click',
            event => {
                if (
                    event.target.closest?.(
                        '#gn-v33-panel,#gn-v33-button'
                    )
                ) {
                    return;
                }


                queuePaint(30);


                setTimeout(
                    paint,
                    180
                );


                setTimeout(
                    paint,
                    500
                );
            },
            true
        );


        document.addEventListener(
            'change',
            event => {
                /*
                 * Don't interpret our own automatic checkbox
                 * changes as user configuration changes.
                 */

                if (
                    startupPresetRunning
                ) {
                    return;
                }


                queuePaint(30);
            },
            true
        );


        /*
         * Changing Vulnona map through #map=...
         * can rebuild the map-specific controls.
         */

        window.addEventListener(
            'hashchange',
            () => {
                queuePaint(30);


                [
                    250,
                    800,
                    1800,
                    3500
                ].forEach(
                    delay => {
                        setTimeout(
                            applyStartupDefaults,
                            delay
                        );
                    }
                );
            }
        );


        /*
         * Initial theme follow-up passes.
         */

        [
            150,
            500,
            1200,
            2500
        ].forEach(
            milliseconds =>
                setTimeout(
                    paint,
                    milliseconds
                )
        );


        /*
         * Slow theme safety repaint.
         */

        setInterval(
            paint,
            2000
        );
    }


    if (
        document.readyState ===
        'loading'
    ) {
        document.addEventListener(
            'DOMContentLoaded',
            start,
            {
                once: true
            }
        );
    }

    else {
        start();
    }

})();
